{
  "name": "@visual-runtime/server",
  "version": "1.0.0",
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "dev": "tsx --watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp -r docs dist/",
    "test": "vitest run",
    "chat:full-turn": "tsx scripts/chat-full-turn.ts",
    "test:sandbox:direct": "node ./scripts/sandbox-direct-test.mjs",
    "test:sandbox:runtime": "node ./scripts/sandbox-runtime-test.mjs",
    "test:sandbox:soak": "node ./scripts/sandbox-soak-test.mjs",
    "test:ws:direct": "node ./scripts/ws-direct-test.mjs",
    "test:ws:runtime": "node ./scripts/ws-runtime-test.mjs",
    "test:ws:soak": "node ./scripts/ws-soak-test.mjs",
    "test:routing:regression": "node ./scripts/routing-regression-test.mjs",
    "test:llm:failover": "node ./scripts/llm-failover-test.mjs",
    "test:threejs:deepdive": "node ./scripts/threejs-constructor-deepdive.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.12",
    "@supabase/supabase-js": "^2.105.3",
    "@visual-runtime/sandbox-pool": "*",
    "@visual-runtime/shared": "*",
    "acorn": "^8.16.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "js-tiktoken": "^1.0.21",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@types/yamljs": "^0.2.34",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "yamljs": "^0.3.0"
  }
}
